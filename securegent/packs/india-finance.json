{
  "name": "india-finance",
  "version": "0.2.0",
  "description": "Starter policy for AI agents handling finance and personal data in India. Inspired by the Digital Personal Data Protection Act 2023, Aadhaar data-handling rules (never share unmasked Aadhaar numbers), PCI DSS for card data, and common RBI-aligned payment controls. A technical starting point, NOT legal advice: review it with your compliance team. Before use, replace 'acme\\.com' with your company's email domain, the vendor list with your approved vendors, and the website allowlist.",
  "tools": "email.read, email.send(to, subject, body, attachment), files.list, files.read(path), payments.pay(vendor, amount in INR), web.fetch(url)",
  "sources": [
    { "tool": ["email.read", "web.fetch"], "label": "untrusted" },
    { "tool": "files.read", "label": "personal",
      "when": [{ "arg": "path", "op": "matches", "value": ".*(customer|client|employee|hr/|kyc|aadhaar|aadhar|pan|payroll|salar).*" }] }
  ],
  "rules": [
    { "id": "inbox-read", "tool": "email.read", "effect": "allow",
      "reason": "agents may read the inbox they were given" },
    { "id": "files-list", "tool": "files.list", "effect": "allow",
      "reason": "listing file names is fine" },

    { "id": "aadhaar-in-email-body", "tool": "email.send",
      "when": [{ "arg": "body", "op": "matches", "value": "(?s).*(?<!\\d)[2-9]\\d{3}[ -]?\\d{4}[ -]?\\d{4}(?!\\d).*" }],
      "effect": "deny", "reason": "unmasked Aadhaar number in email (mask all but the last 4 digits)" },
    { "id": "aadhaar-in-email-subject", "tool": "email.send",
      "when": [{ "arg": "subject", "op": "matches", "value": "(?s).*(?<!\\d)[2-9]\\d{3}[ -]?\\d{4}[ -]?\\d{4}(?!\\d).*" }],
      "effect": "deny", "reason": "unmasked Aadhaar number in email (mask all but the last 4 digits)" },
    { "id": "card-number-in-email", "tool": "email.send",
      "when": [{ "arg": "body", "op": "matches", "value": "(?s).*(?<!\\d)(?:\\d[ -]?){15,18}\\d(?!\\d).*" }],
      "effect": "deny", "reason": "full card number in email (PCI DSS: never send full card numbers)" },
    { "id": "pan-to-outside", "tool": "email.send",
      "when": [{ "arg": "to", "op": "not_matches", "value": "[a-z0-9._%+-]+@acme\\.com" },
               { "arg": "body", "op": "matches", "value": "(?s).*\\b[A-Z]{3}[ABCFGHLJPT][A-Z]\\d{4}[A-Z]\\b.*" }],
      "effect": "deny", "reason": "PAN (personal data) sent outside the company" },
    { "id": "mobile-to-outside", "tool": "email.send",
      "when": [{ "arg": "to", "op": "not_matches", "value": "[a-z0-9._%+-]+@acme\\.com" },
               { "arg": "body", "op": "matches", "value": "(?s).*(?<!\\d)(?:\\+91[ -]?|0)?[6-9]\\d{9}(?!\\d).*" }],
      "effect": "deny", "reason": "Indian mobile number (personal data) sent outside the company" },
    { "id": "attachment-to-outside", "tool": "email.send",
      "when": [{ "arg": "to", "op": "not_matches", "value": "[a-z0-9._%+-]+@acme\\.com" },
               { "arg": "attachment", "op": "not_equals", "value": null }],
      "effect": "deny", "reason": "agents may not send attachments outside the company" },
    { "id": "personal-data-to-outside", "tool": "email.send",
      "when": [{ "arg": "to", "op": "not_matches", "value": "[a-z0-9._%+-]+@acme\\.com" },
               { "arg": "body", "op": "tainted", "value": "personal" }],
      "effect": "deny", "reason": "the email copies personal data the agent read from a file (DPDP, taint)" },
    { "id": "email-internal", "tool": "email.send",
      "when": [{ "arg": "to", "op": "matches", "value": "[a-z0-9._%+-]+@acme\\.com" }],
      "effect": "allow", "reason": "email to exactly one internal address" },
    { "id": "email-external", "tool": "email.send", "effect": "approve",
      "reason": "email outside the company needs a human" },

    { "id": "secret-files", "tool": "files.read",
      "when": [{ "arg": "path", "op": "matches", "value": ".*(secret|password|credential|token|\\.env|\\.pem|\\.key|salar).*" }],
      "effect": "deny", "reason": "secrets and salary data are off limits" },
    { "id": "kyc-files", "tool": "files.read",
      "when": [{ "arg": "path", "op": "matches", "value": ".*(kyc|aadhaar|aadhar|pan[-_ ]?card|passport|voter).*" }],
      "effect": "approve", "reason": "KYC documents need a human (DPDP purpose limitation)" },
    { "id": "files-read", "tool": "files.read", "effect": "allow",
      "reason": "reading ordinary business files is fine" },

    { "id": "payment-auto", "tool": "payments.pay",
      "when": [{ "arg": "vendor", "op": "in", "value": ["Tata Office Supplies"] },
               { "arg": "amount", "op": "gt", "value": 0 },
               { "arg": "amount", "op": "lte", "value": 100000 }],
      "limit": { "sum_arg": "amount", "max": 100000, "window_seconds": 86400 },
      "effect": "allow", "reason": "approved vendor, up to Rs 1 lakh per payment and per day" },
    { "id": "payment-approval", "tool": "payments.pay", "effect": "approve",
      "reason": "large payments and unlisted vendors need a human" },

    { "id": "url-carries-personal-data", "tool": "web.fetch",
      "when": [{ "arg": "url", "op": "matches",
                 "value": ".*((?<!\\d)[2-9]\\d{3}[ -]?\\d{4}[ -]?\\d{4}(?!\\d)|\\b[A-Z]{3}[ABCFGHLJPT][A-Z]\\d{4}[A-Z]\\b|(?<!\\d)[6-9]\\d{9}(?!\\d)).*" }],
      "effect": "deny", "reason": "personal data in a web address (a common way to leak it)" },
    { "id": "url-carries-file-data", "tool": "web.fetch",
      "when": [{ "arg": "url", "op": "tainted", "value": "personal" }],
      "effect": "deny", "reason": "the web address carries personal data the agent read from a file (taint)" },
    { "id": "url-from-content", "tool": "web.fetch",
      "when": [{ "arg": "url", "op": "tainted", "value": "untrusted" }],
      "effect": "approve", "reason": "this web address came from an email or web page, not from you (taint)" },
    { "id": "web-allowlist", "tool": "web.fetch",
      "when": [{ "arg": "url", "op": "startswith", "value": "https://tataoffice.in/" }],
      "effect": "allow", "reason": "approved website" }
  ]
}

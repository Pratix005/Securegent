{
  "rules": [
    {
      "id": "read-inbox",
      "agent": "*",
      "tool": "email.read",
      "effect": "allow",
      "reason": "agents may read the inbox they were given"
    },
    {
      "id": "email-internal",
      "agent": "finance-assistant",
      "tool": "email.send",
      "when": [{ "arg": "to", "op": "matches", "value": "[a-z0-9._%+-]+@acme\\.com" }],
      "effect": "allow",
      "reason": "email to exactly one internal address is fine"
    },
    {
      "id": "email-external-attachment",
      "agent": "finance-assistant",
      "tool": "email.send",
      "when": [{ "arg": "attachment", "op": "not_equals", "value": null }],
      "effect": "deny",
      "reason": "agents may not send attachments outside the company"
    },
    {
      "id": "email-external",
      "agent": "finance-assistant",
      "tool": "email.send",
      "effect": "approve",
      "reason": "external email needs a human to approve"
    },
    {
      "id": "payment-small",
      "agent": "finance-assistant",
      "tool": "payments.pay",
      "when": [
        { "arg": "vendor", "op": "in", "value": ["Tata Office Supplies"] },
        { "arg": "amount", "op": "lte", "value": 100000 }
      ],
      "limit": { "sum_arg": "amount", "max": 100000, "window_seconds": 86400 },
      "effect": "allow",
      "reason": "approved vendors, up to 1 lakh per day in total, are auto-approved"
    },
    {
      "id": "payment-needs-approval",
      "agent": "finance-assistant",
      "tool": "payments.pay",
      "effect": "approve",
      "reason": "large payments and unknown vendors need human approval"
    },
    {
      "id": "read-files",
      "agent": "*",
      "tool": "files.read",
      "when": [{ "arg": "path", "op": "not_contains", "value": "secret" }],
      "effect": "allow",
      "reason": "reading non-secret files is fine"
    },
    {
      "id": "list-files",
      "agent": "*",
      "tool": "files.list",
      "effect": "allow",
      "reason": "listing file names is fine"
    },
    {
      "id": "web-vendor-site",
      "agent": "*",
      "tool": "web.fetch",
      "when": [{ "arg": "url", "op": "startswith", "value": "https://tataoffice.in/" }],
      "effect": "allow",
      "reason": "agents may browse the approved vendor's website"
    }
  ]
}
